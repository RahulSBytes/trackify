generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= Enums =================

enum ApplicationStatus {
  wishlist
  applied
  under_review
  interviewing
  offer_received
  accepted
  rejected
  withdrawn
}

enum JobType {
  full_time
  part_time
  internship
  contract
  freelance
  volunteer
  other
}

enum JobMode {
  remote
  onsite
  hybrid
}

enum ApplicationPortal {
  linkedin
  naukri
  indeed
  wellfound
  instahyre
  glassdoor
  company_careers
  referral
  internshala
  foundit
  cutshort
  upwork
  toptal
  angellist
  other
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum Currency {
  INR
  USD
  EUR
  GBP
  CAD
  AUD
  SGD
  AED
}

// ================= Models =================

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  fullname     String
  image        String?
  applications Application[]
  accounts     Account[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  image             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    String
  company String
  type    JobType
  logo    String?

  status ApplicationStatus @default(applied)

  mode     JobMode?
  location String?

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency Currency?
  salaryPeriod   SalaryPeriod?
  isUnpaid       Boolean       @default(false)

  portal         String?
  applicationUrl String?

  dateApplied         DateTime? @db.Date
  applicationDeadline DateTime? @db.Date
  followUpDate        DateTime? @db.Date

  jobDescription String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("applications")
}
